{
  "name": "pedagogic-point",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "tokens": "design.md export docs/design.md --format dtcg | node scripts/dtcg-to-panda.mjs docs/design.md > theme/tokens.gen.ts",
    "prepare": "npm run tokens && panda codegen",
    "predev": "npm run tokens && panda codegen",
    "dev": "next dev",
    "prebuild": "npm run tokens && panda codegen",
    "build": "next build",
    "start": "next start",
    "prestorybook": "npm run tokens && panda codegen",
    "storybook": "storybook dev -p 6006",
    "prebuild:storybook": "npm run tokens && panda codegen",
    "build:storybook": "storybook build",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "check:slug": "node --experimental-strip-types scripts/check-slug.mts",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "check:contrast": "node --experimental-strip-types scripts/check-contrast.mts",
    "check:tokens": "node --experimental-strip-types scripts/check-tokens.mts",
    "check:a11y": "node --env-file=.env.local scripts/check-a11y.mjs",
    "check:stories": "vitest run --project=storybook"
  },
  "dependencies": {
    "@google/design.md": "^0.4.0",
    "@mdxeditor/editor": "^4.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "markdown-to-jsx": "^9.10.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@pandacss/dev": "^1.12.0",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-vitest": "^10.5.6",
    "@storybook/nextjs-vite": "^10.5.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "playwright": "^1.62.1",
    "storybook": "^10.5.6",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
