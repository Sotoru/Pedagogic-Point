{
  "name": "pedagogic-point",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "design.md export docs/design.md --format dtcg | node scripts/dtcg-to-panda.mjs docs/design.md > theme/tokens.gen.ts",
    "prepare": "npm run tokens && panda codegen",
    "predev": "npm run tokens && panda codegen",
    "dev": "next dev",
    "prebuild": "npm run tokens && panda codegen",
    "build": "next build",
    "start": "next start",
    "prestorybook": "npm run tokens && panda codegen",
    "storybook": "storybook dev -p 6006",
    "prebuild:storybook": "npm run tokens && panda codegen",
    "build:storybook": "storybook build",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "check:slug": "node --experimental-strip-types scripts/check-slug.mts",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "check:contrast": "node --experimental-strip-types scripts/check-contrast.mts",
    "check:tokens": "node --experimental-strip-types scripts/check-tokens.mts",
    "check:a11y": "node --env-file=.env.local scripts/check-a11y.mjs",
    "check:stories": "vitest run --project=storybook"
  },
  "dependencies": {
    "@google/design.md": "^0.4.0",
    "@mdxeditor/editor": "^4.3.3",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "markdown-to-jsx": "^9.10.3",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@pandacss/dev": "^2.2.0",
    "@pandacss/preset-base": "^2.2.0",
    "@pandacss/preset-panda": "^2.2.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-mcp": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/nextjs-vite": "^10.6.2",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/browser": "^5.0.4",
    "@vitest/browser-playwright": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-storybook": "^10.6.2",
    "playwright": "^1.64.0",
    "storybook": "^10.6.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "unrs-resolver@1.12.2": true
  }
}
